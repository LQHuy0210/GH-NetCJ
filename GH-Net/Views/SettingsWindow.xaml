<Window x:Class="GH_Net.WPF.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="{DynamicResource Settings.Title}"
        Width="1040" Height="760"
        MinWidth="920" MinHeight="650"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="DeviceStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Success"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Error"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="194"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#F8FAFC"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,1,0">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Margin="0,14"/>
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource PageBrush}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabStyle" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="12,5"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E7F4FA"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#F0F5F8"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="SettingsStatusStyle" TargetType="Border">
            <Setter Property="Background" Value="#EEF2F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>
        <Style x:Key="DeviceConnectionStatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="PlcTechnicalTemplate">
            <StackPanel>
                <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}" Padding="22"><StackPanel><TextBlock Text="{DynamicResource PlcTech.Send}" FontSize="17" FontWeight="SemiBold"/>
<TextBlock Margin="0,16,0,0" Text="{DynamicResource PlcTech.SendFraming}" FontWeight="SemiBold"/>
<ComboBox Margin="0,7,0,0" ItemsSource="{Binding PlcFramingOptions}" SelectedItem="{Binding SelectedPlcFraming}"/>

                        <TextBlock Margin="0,18,0,0" Text="{DynamicResource Plc.RejectMode}" FontWeight="SemiBold"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="PlcFixedModeRadio" GroupName="PlcRejectMode" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,8" IsChecked="{Binding IsFixedPlcRejectMode}">
                                <TextBlock Text="{DynamicResource Plc.FixedMode}" TextWrapping="Wrap"/>
                            </RadioButton>
                            <RadioButton x:Name="PlcIndexModeRadio" Grid.Column="2" GroupName="PlcRejectMode" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,8" IsChecked="{Binding IsIndexedPlcRejectMode}">
                                <TextBlock Text="{DynamicResource Plc.IndexedMode}" TextWrapping="Wrap"/>
                            </RadioButton>
                        </Grid>


                        <TextBlock Text="{DynamicResource Automation.IndexHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
<TextBlock Margin="0,12,0,7" Text="{DynamicResource Automation.Timeout}" FontWeight="SemiBold"/><TextBox Text="{Binding Automation.TimeoutMs, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,12,0,7" Text="{DynamicResource Automation.Ready}" FontWeight="SemiBold"/><TextBox Text="{Binding Automation.ReadyCommand, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,12,0,7" Text="{DynamicResource Automation.Hold}" FontWeight="SemiBold"/><TextBox Text="{Binding Automation.HoldCommand, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,12,0,7" Text="{DynamicResource Automation.Full}" FontWeight="SemiBold"/><TextBox Text="{Binding Automation.FullCommand, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,12,0,7" Text="{DynamicResource Automation.Fault}" FontWeight="SemiBold"/><TextBox Text="{Binding Automation.FaultCommand, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,12,0,7" Text="{DynamicResource Automation.Stopped}" FontWeight="SemiBold"/><TextBox Text="{Binding Automation.StopCommand, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,16,0,0" Text="{DynamicResource PlcTech.SyncReply}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
                <TextBlock Margin="0,18,0,0" Text="{DynamicResource PlcTech.Sensors}" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Margin="0,5,0,0" Text="{DynamicResource PlcTech.SensorHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                <TabControl x:Name="PlcSensorTabs" ItemsSource="{Binding PlcSensors}" Margin="0,10,0,0" SelectedIndex="0">
                    <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></TabControl.ItemTemplate>
                    <TabControl.ContentTemplate><DataTemplate>
                        <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}" Padding="22"><StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12"><TextBlock Text="{DynamicResource Plc.DelaySensor}" FontWeight="SemiBold"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox MaxLength="5" Text="{Binding DelayDistance, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/><TextBlock Grid.Column="1" Margin="8,0,0,0" Text="mm" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding DelayDistanceError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="11"/></StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="{DynamicResource Plc.DisableSensor}" FontWeight="SemiBold"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox MaxLength="5" Text="{Binding IgnoreDistance, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/><TextBlock Grid.Column="1" Margin="8,0,0,0" Text="mm" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding IgnoreDistanceError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="11"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12"><TextBlock Text="{DynamicResource Plc.PulseEncoder}" FontWeight="SemiBold"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox MaxLength="5" Text="{Binding PulseCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/><TextBlock Grid.Column="1" Margin="8,0,0,0" Text="ppr" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding PulseCountError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="11"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="{DynamicResource Plc.EncoderDiameter}" FontWeight="SemiBold"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox MaxLength="6" Text="{Binding EncoderDiameter, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/><TextBlock Grid.Column="1" Margin="8,0,0,0" Text="mm" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding EncoderDiameterError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="11"/></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12"><TextBlock Text="{DynamicResource Plc.Gap}" FontWeight="SemiBold"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox MaxLength="5" Text="{Binding Gap, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/><TextBlock Grid.Column="1" Margin="8,0,0,0" Text="mm" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding GapError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="11"/></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="{DynamicResource Plc.ErrorCondition}" FontWeight="SemiBold"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox MaxLength="5" Text="{Binding ErrorCondition, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/><TextBlock Grid.Column="1" Margin="8,0,0,0" Text="Unit" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding ErrorConditionError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="11"/></StackPanel>
                            </Grid>
                        </StackPanel></Border>
                    </DataTemplate></TabControl.ContentTemplate>
                </TabControl>
                <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}" Padding="22"><StackPanel>
                    <TextBlock Text="{DynamicResource PlcTech.Receive}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,16,0,7" Text="{DynamicResource PlcTech.SyncRequest}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding PlcSynchronizationRequest, Mode=OneWay}" IsReadOnly="True"/>
                    <TextBlock Margin="0,12,0,0" Text="{DynamicResource PlcTech.ReceiveHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel></Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <Border Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Margin="26,0"
                       Text="{DynamicResource Settings.Title}"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <TabControl x:Name="SettingsTabs"
                    Grid.Row="1"
                    IsEnabled="{Binding CanEdit, Mode=OneWay}"
                    Style="{StaticResource SettingsTabControlStyle}"
                    ItemContainerStyle="{StaticResource SettingsTabStyle}"
                    TabStripPlacement="Left"
                    Background="Transparent"
                    BorderThickness="0">
            <TabItem Visibility="{Binding CanUsePrinter, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabItem.Header>
                    <StackPanel Width="138" Margin="4,7" Orientation="Horizontal">
                        <svgc:SvgIcon Width="21" Height="21"
                                      UriSource="pack://application:,,,/GH-Net;component/Assets/printer.svg"
                                      Fill="Transparent"
                                      Stroke="{StaticResource TextBrush}"/>
                        <TextBlock Margin="11,0,0,0"
                                   Text="{DynamicResource Settings.ZebraPrinter}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,24" IsEnabled="{Binding CanEdit, Mode=OneWay}">
                        <TextBlock Text="{DynamicResource Settings.ZebraPrinter}"
                                   FontSize="19" FontWeight="SemiBold"/>

                        <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="22">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.Ip}" Style="{StaticResource SettingsLabelStyle}"/>
                                        <TextBox Text="{Binding PrinterIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="45"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Settings.Port}" Style="{StaticResource SettingsLabelStyle}"/>
                                        <TextBox Text="{Binding PrinterPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings.CartonZpl}" Style="{StaticResource SettingsLabelStyle}" VerticalAlignment="Bottom"/>
                                    <Button Grid.Column="1"
                                            Content="{DynamicResource Settings.TestCartonPrint}"
                                            Command="{Binding TestCartonPrintCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="14,7" MinHeight="36"/>
                                </Grid>
                                <TextBox Text="{Binding CartonZplTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         FontFamily="Consolas" FontSize="14"
                                         Height="112" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"/>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings.PalletZpl}" Style="{StaticResource SettingsLabelStyle}" VerticalAlignment="Bottom"/>
                                    <Button Grid.Column="1"
                                            Content="{DynamicResource Settings.TestPalletPrint}"
                                            Command="{Binding TestPalletPrintCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="14,7" MinHeight="36"/>
                                </Grid>
                                <TextBox Text="{Binding PalletZplTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         FontFamily="Consolas" FontSize="14"
                                         Height="112" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Style="{StaticResource SettingsStatusStyle}">
                            <TextBlock Text="{Binding PrinterStatusMessage, Mode=OneWay}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Visibility="{Binding CanUseScanner, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabItem.Header>
                    <StackPanel Width="138" Margin="4,7" Orientation="Horizontal">
                        <svgc:SvgIcon Width="21" Height="21"
                                      UriSource="pack://application:,,,/GH-Net;component/Assets/scanner.svg"
                                      Fill="Transparent"
                                      Stroke="{StaticResource TextBrush}"/>
                        <TextBlock Margin="11,0,0,0"
                                   Text="{DynamicResource Settings.Scanner}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,24" IsEnabled="{Binding CanEdit, Mode=OneWay}">
                        <TextBlock Text="{DynamicResource Settings.Scanner}"
                                   FontSize="19" FontWeight="SemiBold"/>

                        <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="22">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.ComPort}" Style="{StaticResource SettingsLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding ScannerPorts, Mode=OneWay}"
                                                  SelectedItem="{Binding SelectedScannerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="{DynamicResource Common.Refresh}"
                                            Command="{Binding RefreshScannerPortsCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            VerticalAlignment="Bottom"/>
                                </Grid>

                                <UniformGrid Columns="3" Margin="0,20,0,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource Settings.BaudRate}" Style="{StaticResource SettingsLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding BaudRates, Mode=OneWay}"
                                                  SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0">
                                        <TextBlock Text="{DynamicResource Settings.DataBits}" Style="{StaticResource SettingsLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding DataBitsOptions, Mode=OneWay}"
                                                  SelectedItem="{Binding SelectedDataBits, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource Settings.Parity}" Style="{StaticResource SettingsLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding ParityOptions, Mode=OneWay}"
                                                  SelectedItem="{Binding SelectedParity, Mode=TwoWay}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="3" Margin="0,16,0,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource Settings.StopBits}" Style="{StaticResource SettingsLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding StopBitsOptions, Mode=OneWay}"
                                                  SelectedItem="{Binding SelectedStopBits, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0">
                                        <TextBlock Text="{DynamicResource Settings.Terminator}" Style="{StaticResource SettingsLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding ScannerTerminatorOptions, Mode=OneWay}"
                                                  SelectedItem="{Binding ScannerTerminator, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource Settings.TimeoutMs}" Style="{StaticResource SettingsLabelStyle}"/>
                                        <TextBox Text="{Binding ScannerTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Margin="0,18,0,0"
                                           Text="{DynamicResource Settings.ScannerHint}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Style="{StaticResource SettingsStatusStyle}">
                            <TextBlock Text="{Binding ScannerStatusMessage, Mode=OneWay}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="CameraSettingsTab" Visibility="{Binding CanUseCamera, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabItem.Header>
                    <StackPanel Width="132"
                                Margin="4,8"
                                Orientation="Horizontal">
                        <svgc:SvgIcon Width="20" Height="20"
                                      UriSource="pack://application:,,,/GH-Net;component/Assets/camera.svg"
                                      Fill="Transparent"
                                      Stroke="{StaticResource TextBrush}"/>
                        <TextBlock Margin="10,0,0,0"
                                   Text="{DynamicResource Common.Camera}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22"
                                IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="{DynamicResource Common.Camera}"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Border Margin="0,16,0,0"
                                Style="{StaticResource CardStyle}"
                                Padding="22">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="145"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.Ip}"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Margin="0,7,0,0"
                                                 Text="{Binding CameraIp,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Settings.Port}"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Margin="0,7,0,0"
                                                 Text="{Binding CameraPort,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="5"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.CameraTerminator}"
                                                   FontWeight="SemiBold"/>
                                        <ComboBox Margin="0,7,0,0"
                                                  ItemsSource="{Binding CameraTerminatorOptions}"
                                                  SelectedItem="{Binding CameraTerminator}"/>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}" Padding="22">
                            <StackPanel><TextBlock Text="{DynamicResource Automation.NoRead}" FontWeight="SemiBold"/><TextBox Margin="0,7,0,0" Text="{Binding Automation.NoReadToken, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Border>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="0"/>
                                    <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>
                            <Border Padding="12,9"
                                    CornerRadius="6"
                                    Background="#EEF2F6">
                                <TextBlock x:Name="CameraConnectionStatus" Text="{Binding CameraStatusMessage}" TextWrapping="Wrap" Tag="{Binding CameraStatusTone}" Style="{StaticResource DeviceStatusTextStyle}"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="PlcSettingsTab" Visibility="{Binding CanUsePlc, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabItem.Header><StackPanel Width="132" Margin="4,8" Orientation="Horizontal">
                    <svgc:SvgIcon Width="20" Height="20" UriSource="pack://application:,,,/GH-Net;component/Assets/plc.svg" Fill="Transparent" Stroke="{StaticResource TextBrush}"/>
                    <TextBlock Margin="10,0,0,0" Text="PLC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel></TabItem.Header>
                <ScrollViewer x:Name="PlcSettingsScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,22">
                    <TextBlock Text="PLC" FontSize="18" FontWeight="SemiBold"/>
                    <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="22"><StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{DynamicResource Settings.Ip}" FontWeight="SemiBold"/>
                                <TextBox Margin="0,7,0,0" MaxLength="15" Text="{Binding PlcIp, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Settings.Port}" FontWeight="SemiBold"/>
                                <TextBox Margin="0,7,0,0" MaxLength="5" Text="{Binding PlcPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                    </StackPanel></Border>

                    <Border Margin="0,18,0,0" Style="{StaticResource SettingsStatusStyle}"><StackPanel>
                        <TextBlock Text="{DynamicResource PlcTech.LockedHint}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource PlcTech.Unlock}" Click="TechnicalAccess_Click">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTechnicalUnlocked}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="{DynamicResource PlcTech.Lock}" Click="LockTechnical_Click" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsTechnicalUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel></Border>
                    <ContentControl x:Name="PlcTechnicalHost">
                        <ContentControl.Style><Style TargetType="ContentControl">
                            <Setter Property="Content" Value="{x:Null}"/>
                            <Setter Property="ContentTemplate" Value="{x:Null}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsTechnicalUnlocked}" Value="True">
                                <Setter Property="Content" Value="{Binding}"/>
                                <Setter Property="ContentTemplate" Value="{StaticResource PlcTechnicalTemplate}"/>
                            </DataTrigger></Style.Triggers>
                        </Style></ContentControl.Style>
                    </ContentControl>
                    <Border Margin="0,18,0,0" Padding="12,9" CornerRadius="6" Background="#EEF2F6">
                        <TextBlock x:Name="PlcConnectionStatus" Text="{Binding PlcStatusMessage}" TextWrapping="Wrap" Tag="{Binding PlcStatusTone}" Style="{StaticResource DeviceStatusTextStyle}"/>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Button HorizontalAlignment="Right"
                    MinWidth="150"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding CanEdit, Mode=OneWay}"
                    Click="Apply_Click">
                <StackPanel Orientation="Horizontal">
                    <svgc:SvgIcon Width="18" Height="18" Margin="0,0,9,0"
                                  UriSource="pack://application:,,,/GH-Net;component/Assets/synced.svg"
                                  Fill="White" Stroke="White"/>
                    <TextBlock Text="{DynamicResource Common.Apply}"/>
                </StackPanel>
            </Button>
        </Border>

        <Border Grid.RowSpan="3"
                Background="#66FFFFFF"
                Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="190" Height="7"
                             IsIndeterminate="True"
                             Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Margin="0,11,0,0"
                           Text="{DynamicResource Common.Processing}"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
