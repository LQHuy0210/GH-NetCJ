<Window x:Class="GH_Net.WPF.Views.CreateJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Create.PackingTitle}" Width="1040" Height="760"
        MinWidth="920" MinHeight="650" WindowStartupLocation="CenterOwner">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{DynamicResource Create.PackingTitle}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Create.PackingDescription}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="18">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="220"/><ColumnDefinition Width="20"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{DynamicResource Create.JobName}" FontWeight="SemiBold"/><TextBox Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0"/><Button Content="{DynamicResource Create.AutoName}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" Click="GenerateName_Click"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Create.ProductsPerCarton}" FontWeight="SemiBold"/><TextBox Text="{Binding ProductsPerCarton, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="{DynamicResource Create.CartonsPerPallet}" FontWeight="SemiBold"/><TextBox Text="{Binding CartonsPerPallet, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <ItemsControl Margin="0,14,0,0">
                    <ItemsControl.Items>
                        <Grid Tag="Product"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Create.ProductCsv}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" ToolTip="{Binding Products.FilePath}" Click="ChooseProduct_Click" Margin="10,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Content" Value="{Binding Products.FileName}"/><Style.Triggers><DataTrigger Binding="{Binding Products.FilePath}" Value=""><Setter Property="Content" Value="{DynamicResource Create.ChooseCsv}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><ComboBox Grid.Column="2" ItemsSource="{Binding Products.Headers}" SelectedItem="{Binding Products.SelectedColumn}"/></Grid>
                        <Grid Tag="Carton" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Create.CartonCsv}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" ToolTip="{Binding Cartons.FilePath}" Click="ChooseCarton_Click" Margin="10,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Content" Value="{Binding Cartons.FileName}"/><Style.Triggers><DataTrigger Binding="{Binding Cartons.FilePath}" Value=""><Setter Property="Content" Value="{DynamicResource Create.ChooseCsv}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><ComboBox Grid.Column="2" ItemsSource="{Binding Cartons.Headers}" SelectedItem="{Binding Cartons.SelectedColumn}"/></Grid>
                        <Grid Tag="Pallet" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Create.PalletCsv}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" ToolTip="{Binding Pallets.FilePath}" Click="ChoosePallet_Click" Margin="10,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Content" Value="{Binding Pallets.FileName}"/><Style.Triggers><DataTrigger Binding="{Binding Pallets.FilePath}" Value=""><Setter Property="Content" Value="{DynamicResource Create.ChooseCsv}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><ComboBox Grid.Column="2" ItemsSource="{Binding Pallets.Headers}" SelectedItem="{Binding Pallets.SelectedColumn}"/></Grid>
                    </ItemsControl.Items>
                </ItemsControl>
                <Border Background="#F4F8FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,18,0,0">
                    <TextBlock Text="{DynamicResource Create.CsvRule}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{DynamicResource Create.Cancel}" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
            <Button Grid.Column="3" Content="{DynamicResource Create.Submit}" Style="{StaticResource PrimaryButtonStyle}" Click="Create_Click"/>
        </Grid>
    </Grid>
</Window>
