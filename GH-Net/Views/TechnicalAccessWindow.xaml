<Window x:Class="GH_Net.WPF.Views.TechnicalAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PlcTech.Title}" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="Description" Margin="0,12,0,18" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
        <TextBlock Text="{DynamicResource PlcTech.Code}" FontWeight="SemiBold"/>
        <PasswordBox x:Name="CodeBox" MaxLength="64" Margin="0,7,0,0" Padding="8"/>
        <StackPanel x:Name="Confirmation" Margin="0,14,0,0">
            <TextBlock Text="{DynamicResource PlcTech.ConfirmCode}" FontWeight="SemiBold"/>
            <PasswordBox x:Name="ConfirmBox" MaxLength="64" Margin="0,7,0,0" Padding="8"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource Create.Cancel}" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="Submit" Margin="10,0,0,0" Content="{DynamicResource Common.Apply}" IsDefault="True" Click="Submit_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</Window>
