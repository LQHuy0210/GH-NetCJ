<Window x:Class="GH_Net.WPF.Views.DeleteJobsConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="{DynamicResource Jobs.DeleteConfirmTitle}"
        Width="500"
        SizeToContent="Height"
        MaxHeight="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,22,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="46" Height="46"
                    CornerRadius="23"
                    Background="#FDEBEC">
                <svgc:SvgIcon Width="21" Height="21"
                              UriSource="pack://application:,,,/GH-Net;component/Assets/delete.svg"
                              Fill="{StaticResource DangerBrush}"
                              Stroke="{StaticResource DangerBrush}"/>
            </Border>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">
                <TextBlock x:Name="QuestionText"
                           FontSize="20"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0"
                           Text="{DynamicResource Jobs.DeleteWarning}"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="ErrorText"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="24,0,24,22"
                Padding="4"
                MaxHeight="230"
                CornerRadius="7"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Background="#FAFBFC">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="JobNamesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource DangerBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Padding="24,15"
                Background="#F8FAFC"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button MinWidth="96"
                        Content="{DynamicResource Create.Cancel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"/>
                <Button MinWidth="112"
                        Margin="10,0,0,0"
                        Content="{DynamicResource Common.Delete}"
                        Style="{StaticResource DangerButtonStyle}"
                        IsDefault="True"
                        Click="Delete_Click"/>
            </StackPanel>
        </Border>

        <Border x:Name="ProcessingOverlay"
                Grid.RowSpan="3"
                Panel.ZIndex="10"
                Background="#F5FFFFFF"
                Visibility="Collapsed">
            <Border MinWidth="340" MaxWidth="440"
                    Padding="26,22"
                    CornerRadius="9"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar Height="6"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Margin="0,14,0,0"
                               Text="{DynamicResource Jobs.Deleting}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,5,0,0"
                               Text="{DynamicResource Jobs.DeletePleaseWait}"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
