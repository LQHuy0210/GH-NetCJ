<Window x:Class="GH_Net.WPF.Views.PackingExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PackingExport.Title}"
        Width="600"
        Height="500"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource PackingExport.Title}"
                       FontSize="23"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding JobName}"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18"
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{DynamicResource PackingExport.Scope}"
                           FontWeight="SemiBold"/>
                <ComboBox Margin="0,8,0,0"
                          ItemsSource="{Binding Scopes}"
                          SelectedItem="{Binding SelectedScope}"
                          DisplayMemberPath="Text"/>

                <TextBlock Margin="0,14,0,0"
                           Text="{DynamicResource PackingExport.Format}"
                           FontWeight="SemiBold"/>
                <ComboBox Margin="0,8,0,0"
                          ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding SelectedFormat}"
                          DisplayMemberPath="Text"/>

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding IsUnusedScope, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource PackingExport.CodeTypes}"
                               FontWeight="SemiBold"/>
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <CheckBox Content="{DynamicResource PackingExport.IncludeProducts}"
                                  IsChecked="{Binding IncludeProducts}"/>
                        <CheckBox Margin="24,0,0,0"
                                  Content="{DynamicResource PackingExport.IncludeCartons}"
                                  IsChecked="{Binding IncludeCartons}"/>
                        <CheckBox Margin="24,0,0,0"
                                  Content="{DynamicResource PackingExport.IncludePallets}"
                                  IsChecked="{Binding IncludePallets}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Margin="0,14,0,0"
                           Text="{Binding Description}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Margin="0,14,0,0"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100"
                    Content="{DynamicResource Common.Close}"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Margin="10,0,0,0"
                    Width="120"
                    Content="{DynamicResource PackingExport.Action}"
                    Command="{Binding ExportCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
