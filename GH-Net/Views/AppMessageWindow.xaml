<Window x:Class="GH_Net.WPF.Views.AppMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Width="460"
        SizeToContent="Height"
        MaxHeight="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,22,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="IconBackground"
                    Width="46"
                    Height="46"
                    CornerRadius="23">
                <svgc:SvgIcon x:Name="MessageIcon"
                              Width="21"
                              Height="21"/>
            </Border>

            <TextBlock x:Name="HeadingText"
                       Grid.Column="2"
                       FontSize="20"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="24,0,24,22"
                      MaxHeight="300"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText"
                       FontSize="14"
                       LineHeight="22"
                       TextWrapping="Wrap"/>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="24,15"
                Background="#F8FAFC"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Button MinWidth="96"
                    HorizontalAlignment="Right"
                    Content="{DynamicResource Common.OK}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsCancel="True"
                    Click="Ok_Click"/>
        </Border>
    </Grid>
</Window>
