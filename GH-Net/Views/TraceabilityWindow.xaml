<Window x:Class="GH_Net.WPF.Views.TraceabilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:GH_Net.Core.Enums;assembly=GH-Net.Core"
        Title="{DynamicResource Trace.Title}"
        Width="1120" Height="760"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="TraceLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="TraceValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TraceSectionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>

        <DataTemplate x:Key="ProductDetailTemplate">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Trace.ProductDetails}" FontSize="18" FontWeight="SemiBold"/>
                        <UniformGrid Columns="4" Margin="0,18,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Trace.Code}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Product.Code, Mode=OneWay}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,8,0">
                                <TextBlock Text="{DynamicResource Trace.Status}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Product.Status, Mode=OneWay}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,4,0">
                                <TextBlock Text="{DynamicResource Trace.ScannedAt}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Product.ScannedAt, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="{DynamicResource Trace.PackedAt}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Product.PackedAt, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource Trace.ParentInformation}" Style="{StaticResource TraceSectionStyle}"/>
                <UniformGrid Columns="2">
                    <Border Margin="0,0,8,0" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Carton" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Carton.Code, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,9,0,0"/>
                            <TextBlock Text="{Binding Carton.Status, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Pallet" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Pallet.Code, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,9,0,0"/>
                            <TextBlock Text="{Binding Pallet.Status, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CartonDetailTemplate">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Trace.CartonDetails}" FontSize="18" FontWeight="SemiBold"/>
                        <UniformGrid Columns="4" Margin="0,18,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Trace.Code}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Carton.Code, Mode=OneWay}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,8,0">
                                <TextBlock Text="{DynamicResource Trace.Status}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Carton.Status, Mode=OneWay}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,4,0">
                                <TextBlock Text="{DynamicResource Trace.ProductCount}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Carton.ProductCount, Mode=OneWay}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="{DynamicResource Trace.CompletedAt}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Carton.CompletedAt, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource Trace.ParentInformation}" Style="{StaticResource TraceSectionStyle}"/>
                <Border Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pallet" Style="{StaticResource TraceLabelStyle}"/>
                            <TextBlock Text="{Binding Pallet.Code, Mode=OneWay}" Style="{StaticResource TraceValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Trace.Status}" Style="{StaticResource TraceLabelStyle}"/>
                            <TextBlock Text="{Binding Pallet.Status, Mode=OneWay}" Style="{StaticResource TraceValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Trace.CartonCount}" Style="{StaticResource TraceLabelStyle}"/>
                            <TextBlock Text="{Binding Pallet.CartonCount, Mode=OneWay}" Style="{StaticResource TraceValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{DynamicResource Trace.ChildProducts}" Style="{StaticResource TraceSectionStyle}"/>
                <DataGrid ItemsSource="{Binding Carton.Products, Mode=OneWay}" Height="230" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding Code, Mode=OneWay}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Trace.Status}" Binding="{Binding Status, Mode=OneWay}" Width="150"/>
                        <DataGridTextColumn Header="{DynamicResource Trace.ScannedAt}" Binding="{Binding ScannedAt, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="190"/>
                        <DataGridTextColumn Header="{DynamicResource Trace.PackedAt}" Binding="{Binding PackedAt, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="190"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PalletDetailTemplate">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Trace.PalletDetails}" FontSize="18" FontWeight="SemiBold"/>
                        <UniformGrid Columns="4" Margin="0,18,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Trace.Code}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Pallet.Code, Mode=OneWay}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,8,0">
                                <TextBlock Text="{DynamicResource Trace.Status}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Pallet.Status, Mode=OneWay}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,4,0">
                                <TextBlock Text="{DynamicResource Trace.CartonCount}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Pallet.CartonCount, Mode=OneWay}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="{DynamicResource Trace.CompletedAt}" Style="{StaticResource TraceLabelStyle}"/>
                                <TextBlock Text="{Binding Pallet.CompletedAt, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Style="{StaticResource TraceValueStyle}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource Trace.ChildCartons}" Style="{StaticResource TraceSectionStyle}"/>
                <DataGrid ItemsSource="{Binding Pallet.Cartons, Mode=OneWay}" Height="310" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Carton" Binding="{Binding Code, Mode=OneWay}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Trace.Status}" Binding="{Binding Status, Mode=OneWay}" Width="140"/>
                        <DataGridTextColumn Header="{DynamicResource Trace.ProductCount}" Binding="{Binding ProductCount, Mode=OneWay}" Width="130"/>
                        <DataGridTextColumn Header="{DynamicResource Trace.PrintedAt}" Binding="{Binding PrintedAt, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="180"/>
                        <DataGridTextColumn Header="{DynamicResource Trace.CompletedAt}" Binding="{Binding CompletedAt, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Margin="28,0" Text="{DynamicResource Trace.Title}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Margin="28,20,28,0" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Trace.SearchCode}" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{DynamicResource Trace.Search}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="28,14,28,0" Visibility="{Binding HasSelectedResult, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Trace.Result}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Results, Mode=OneWay}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" DisplayMemberPath="DisplayLabel"/>
            </Grid>
            <Border Margin="0,10,0,0" Background="#EAF5FB" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <TextBlock Text="{Binding SelectedResult.Breadcrumb, Mode=OneWay}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="3" Margin="28,16,28,0" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding SelectedResult, Mode=OneWay}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedResult.ResultType}" Value="{x:Static enums:ScanCodeType.Product}">
                                <Setter Property="ContentTemplate" Value="{StaticResource ProductDetailTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedResult.ResultType}" Value="{x:Static enums:ScanCodeType.Carton}">
                                <Setter Property="ContentTemplate" Value="{StaticResource CartonDetailTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedResult.ResultType}" Value="{x:Static enums:ScanCodeType.Pallet}">
                                <Setter Property="ContentTemplate" Value="{StaticResource PalletDetailTemplate}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </ScrollViewer>

        <TextBlock Grid.Row="4" Margin="28,12,28,18" Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>

        <Border Grid.RowSpan="5" Background="#66FFFFFF" Visibility="{Binding Busy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="190" Height="7" IsIndeterminate="True" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Margin="0,11,0,0" Text="{DynamicResource Common.Processing}" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
